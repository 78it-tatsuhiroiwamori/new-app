{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm publish *)",
      "Bash(npx *)",
      "Bash(npm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn dlx *)",
      "Bash(bunx *)",
      "Bash(docker *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(iwr *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(irm *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(iex *)",
      "PowerShell(npm publish *)",
      "PowerShell(npx *)",
      "PowerShell(npm exec *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(yarn dlx *)",
      "PowerShell(bunx *)",
      "PowerShell(docker *)",
      "WebFetch"
