    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/gcloud/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(.claude/settings*.json)",
      "Edit(**/.claude/settings*.json)",
      "Edit(~/.claude/settings*.json)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git config --global *)",
      "Bash(chmod 777 *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(declare -x)",
      "Bash(declare -p*)",
      "Bash(cat /proc/*/environ)",
      "PowerShell(Remove-Item -r*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(rm -r*)",
      "PowerShell(rm * -r*)",
      "PowerShell(ri -r*)",
      "PowerShell(ri * -r*)",
      "PowerShell(del -r*)",
      "PowerShell(del * -r*)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "PowerShell(git push --force)",
      "PowerShell(git push -f)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git show *--output*)",
      "PowerShell(git config --global *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
